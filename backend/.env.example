# --- Application ---
ENVIRONMENT=development
PROJECT_NAME=Placement Prep API

# --- CORS (comma-separated frontend origins) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_prep

# --- Auth / JWT ---
# Generate a strong key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM (Phase 4 job-description analysis) ---
# Leave LLM_API_KEY empty to use the transparent rule-based fallback.
# Any OpenAI-compatible endpoint works; examples:
#   OpenAI:     https://api.openai.com/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://localhost:11434/v1
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
